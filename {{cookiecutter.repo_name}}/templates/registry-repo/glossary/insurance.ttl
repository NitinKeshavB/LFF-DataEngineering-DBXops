# Stub concepts; the platform team enriches this into the full ontology.
# Base IRI is a PLACEHOLDER until iri_base in repo.yaml is set.

@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ins:  <https://PLACEHOLDER-ontology-host/insurance#> .

ins:scheme a skos:ConceptScheme ;
    rdfs:label "Insurance" .

ins:Policy a skos:Concept ;
    skos:inScheme ins:scheme ;
    rdfs:label "Policy" ;
    skos:definition "A contract of insurance between an insurer and a policyholder." .

ins:Policyholder a skos:Concept ;
    skos:inScheme ins:scheme ;
    rdfs:label "Policyholder" ;
    skos:definition "The party that owns an insurance policy." .

ins:Coverage a skos:Concept ;
    skos:inScheme ins:scheme ;
    skos:broader ins:Policy ;
    rdfs:label "Coverage" ;
    skos:definition "A specific risk insured under a policy, with its limits and deductibles." .

ins:Premium a skos:Concept ;
    skos:inScheme ins:scheme ;
    skos:broader ins:Policy ;
    rdfs:label "Premium" ;
    skos:definition "The amount charged for insurance coverage over a period." .

ins:Claim a skos:Concept ;
    skos:inScheme ins:scheme ;
    rdfs:label "Claim" ;
    skos:definition "A request by a policyholder for payment under a policy." .

ins:Loss a skos:Concept ;
    skos:inScheme ins:scheme ;
    skos:broader ins:Claim ;
    rdfs:label "Loss" ;
    skos:definition "The financial amount of damage or liability giving rise to a claim." .

ins:Reserve a skos:Concept ;
    skos:inScheme ins:scheme ;
    skos:broader ins:Claim ;
    rdfs:label "Reserve" ;
    skos:definition "Funds set aside to pay the expected cost of an open claim." .
